# URL de connexion à la base PostgreSQL (Neon ou locale)
# Lors du déploiement Vercel avec l'intégration Neon Storage, cette variable est injectée automatiquement.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Secret d'authentification de session (générer par ex: openssl rand -base64 32)
NEXTAUTH_SECRET="meteor_pro_inventaire_immobilisations_secret_key_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# URL publique de l'application (utilisée pour encoder l'URL complète dans le QR code)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
